#!/bin/sh
# テスト用の pinentry。本物の pinentry と同じやり取り（Assuan）で、決まった答えを返す。
# 鍵束（--homedir）に写し、gpg-agent.conf の pinentry-program で指して使う。
# 答えは同じディレクトリの pinentry-answer の中身。ファイルがなければ入力を取り消したことにする。
# 答えを変えたら gpgconf --reload gpg-agent で gpg-agent が覚えたパスフレーズを忘れさせる。
# pinentry-flavor があれば、その種類（curses・tty など）の pinentry だと名乗る。
dir=$(dirname "$0")
echo "OK fake pinentry"
repeat=
while IFS= read -r line; do
    case "$line" in
    SETREPEAT*)
        # 新しいパスフレーズ（鍵の作成）では、2 回目の入力も一致したと答える
        repeat=1
        echo OK
        ;;
    "GETINFO flavor")
        if [ -f "$dir/pinentry-flavor" ]; then
            printf 'D %s\n' "$(cat "$dir/pinentry-flavor")"
        fi
        echo OK
        ;;
    GETPIN)
        if [ -f "$dir/pinentry-answer" ]; then
            printf 'D %s\n' "$(cat "$dir/pinentry-answer")"
            if [ -n "$repeat" ]; then
                echo "S PIN_REPEATED"
            fi
            echo OK
        else
            # GPG_ERR_CANCELED（発生源は pinentry）
            echo "ERR 83886179 Operation cancelled <Pinentry>"
        fi
        ;;
    BYE)
        echo OK
        exit 0
        ;;
    *)
        # 弱いパスフレーズの確認（CONFIRM）なども、そのまま受け入れる
        echo OK
        ;;
    esac
done
